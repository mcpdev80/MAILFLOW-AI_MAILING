# MailFlow — Environment variables
# Copy to .env and fill in your values. Never commit .env.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mailflow:mailflow@localhost:5432/mailflow

# ── Redis (ARQ queue) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Crypto ────────────────────────────────────────────────────────────────────
# REQUIRED. Existing deployment signing secret. While SECRET_ENCRYPTION_KEYS is
# empty, this is also used as the legacy Fernet key for encrypted DB credentials.
# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
# Optional independent Fernet key ring for database secrets. First key = primary
# for new writes, later keys = decrypt-only fallbacks during rotation. Once this
# variable is set it fully owns DB encryption; SECRET_KEY is no longer added.
# Example migration/rotation from the legacy key:
#   SECRET_ENCRYPTION_KEYS=NEW_FERNET_KEY,OLD_SECRET_KEY
#   python -m app.secret_rotation
#   SECRET_ENCRYPTION_KEYS=NEW_FERNET_KEY
# Keep active encryption keys outside PostgreSQL and outside database backups.
SECRET_ENCRYPTION_KEYS=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── API auth mode ─────────────────────────────────────────────────────────────
AUTH_MODE=single
SINGLE_TENANT_API_KEY=

# ── Auth (Better Auth — web layer, SaaS) ──────────────────────────────────────
WEB_AUTH=off
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000
WEB_SECRET_KEY=change-me-too-in-production
API_INTERNAL_URL=http://localhost:8000

# ── Internal web ↔ API trust secret ───────────────────────────────────────────
INTERNAL_API_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── OAuth — Microsoft 365 ─────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── OAuth — Gmail ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — redirect/callback ─────────────────────────────────────────────────
OAUTH_REDIRECT_BASE=http://localhost:8000
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/app/dashboard

# ── Billing (Stripe) — SaaS only ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
BILLING_SUCCESS_URL=http://localhost:3000/app/billing?status=success
BILLING_CANCEL_URL=http://localhost:3000/app/billing?status=cancel

# ── LLM defaults (LiteLLM) ───────────────────────────────────────────────────
LITELLM_DEFAULT_MODEL=ollama/llama3.1:8b
LITELLM_DEFAULT_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ── Workers ───────────────────────────────────────────────────────────────────
WORKER_CYCLE_INTERVAL_SECONDS=300
WORKER_MAX_EMAILS_PER_CYCLE=20

# ── Observability ─────────────────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO
ENVIRONMENT=development
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
