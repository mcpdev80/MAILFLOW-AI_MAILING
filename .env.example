# MailFlow — application configuration
# Copy to .env for BaseHarbor-managed self-hosting. Never commit .env.
# PostgreSQL, Valkey and required managed secrets are intentionally not configured here.

# ── Deployment/bootstrap metadata ─────────────────────────────────────────────
MAILFLOW_DEPLOYMENT_SOURCE=baseharbor
MAILFLOW_BOOTSTRAP_LANGUAGE=
MAILFLOW_TLS_MODE=

# ── Public HTTPS edge ─────────────────────────────────────────────────────────
MAILFLOW_PUBLIC_URL=https://localhost
MAILFLOW_CADDY_ADDRESS=https://localhost
HTTP_PORT=80
HTTPS_PORT=443
MAILFLOW_PORTS_MANAGED=
TLS_CERT_FILE=
TLS_KEY_FILE=
MAILFLOW_CA_BUNDLE=

# ── BaseHarbor-managed runtime contract ───────────────────────────────────────
# Do not set these for the normal BaseHarbor deployment. `baha app apply`
# provides them to the application workload.
# DATABASE_URL=postgresql://...
# REDIS_URL=redis://...
# SECRET_KEY=...
#
# The explicit standalone compatibility stack defines its own PostgreSQL/Redis
# defaults in infrastructure/docker-compose.standalone.yml.

# ── Assistant runtime ─────────────────────────────────────────────────────────
# disabled | openai_compatible | mcp
# MailFlow owns tool semantics, authorization and confirmation policy. Provider
# selection remains application-owned and is not configured by BaseHarbor.
ASSISTANT_RUNTIME=disabled
OPENAI_BASE_URL=
MCP_ENDPOINT=

# ── Crypto ────────────────────────────────────────────────────────────────────
# SECRET_KEY is a required BaseHarbor/OpenBao managed secret.
SECRET_ENCRYPTION_KEYS=

# ── CORS / API exposure ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
API_DOCS_ENABLED=false

# ── API auth mode ─────────────────────────────────────────────────────────────
AUTH_MODE=single
SINGLE_TENANT_API_KEY=

# ── Auth (Better Auth — web layer) ────────────────────────────────────────────
WEB_AUTH=off
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000
PASSKEY_RP_NAME=MailFlow
PASSKEY_RP_ID=
PASSKEY_ORIGIN=
WEB_SECRET_KEY=change-me-too-in-production
API_INTERNAL_URL=http://api:8000

# ── Internal web ↔ API trust secret ───────────────────────────────────────────
INTERNAL_API_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── OAuth — Microsoft 365 ─────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── OAuth — Gmail ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — redirect/callback ─────────────────────────────────────────────────
OAUTH_REDIRECT_BASE=http://localhost:8000
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/app/dashboard

# ── Billing (Stripe) — optional ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
BILLING_SUCCESS_URL=http://localhost:3000/app/billing?status=success
BILLING_CANCEL_URL=http://localhost:3000/app/billing?status=cancel

# ── LLM defaults ───────────────────────────────────────────────────────────────
LITELLM_DEFAULT_MODEL=ollama/llama3.1:8b
LITELLM_DEFAULT_BASE_URL=http://localhost:11434
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.85
DECISION_MEMORY_REUSE_THRESHOLD=0.93
DECISION_MEMORY_HINT_THRESHOLD=0.68
DECISION_MEMORY_DECAY_DAYS=180
CLASSIFICATION_STAGE_0_ROLE=fast
CLASSIFICATION_STAGE_1_ROLE=fast
CLASSIFICATION_STAGE_2_ROLE=deep
CLASSIFICATION_STAGE_3_ROLE=deep
THREAD_SUMMARY_MODEL_ROLE=fast
BACKFILL_MAX_CLASSIFICATION_STAGE=1
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ── Attachment extraction ─────────────────────────────────────────────────────
ATTACHMENT_MAX_BYTES=5242880
ATTACHMENT_MAX_EXTRACTED_CHARS=8000
ATTACHMENT_MAX_COUNT=2
ATTACHMENT_MAX_PDF_PAGES=50
ATTACHMENT_MAX_ARCHIVE_ENTRIES=64
ATTACHMENT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=2097152

# ── Workers ───────────────────────────────────────────────────────────────────
WORKER_CYCLE_INTERVAL_SECONDS=300
WORKER_MAX_EMAILS_PER_CYCLE=20
WORKER_PAUSED=false

# ── Observability ──────────────────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO
ENVIRONMENT=production
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Billing / retention defaults ──────────────────────────────────────────────
BILLING_PROVIDER=none
DATA_RETENTION_DAYS=30
