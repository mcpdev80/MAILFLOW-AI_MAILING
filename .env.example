# MailFlow — Environment variables
# Copy to .env and fill in your values. Never commit .env.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mailflow:mailflow@localhost:5432/mailflow

# ── Redis (ARQ queue) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Crypto ────────────────────────────────────────────────────────────────────
SECRET_KEY=
SECRET_ENCRYPTION_KEYS=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── API auth mode ─────────────────────────────────────────────────────────────
AUTH_MODE=single
SINGLE_TENANT_API_KEY=

# ── Auth (Better Auth — web layer, SaaS) ──────────────────────────────────────
WEB_AUTH=off
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000
PASSKEY_RP_NAME=MailFlow
PASSKEY_RP_ID=
PASSKEY_ORIGIN=
WEB_SECRET_KEY=change-me-too-in-production
API_INTERNAL_URL=http://localhost:8000

# ── Internal web ↔ API trust secret ───────────────────────────────────────────
INTERNAL_API_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── OAuth — Microsoft 365 ─────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── OAuth — Gmail ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — redirect/callback ─────────────────────────────────────────────────
OAUTH_REDIRECT_BASE=http://localhost:8000
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/app/dashboard

# ── Billing (Stripe) — SaaS only ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
BILLING_SUCCESS_URL=http://localhost:3000/app/billing?status=success
BILLING_CANCEL_URL=http://localhost:3000/app/billing?status=cancel

# ── LLM defaults (LiteLLM) ───────────────────────────────────────────────────
LITELLM_DEFAULT_MODEL=ollama/llama3.1:8b
LITELLM_DEFAULT_BASE_URL=http://localhost:11434
# Escalate to the next classification stage below this confidence, or whenever
# the model sets needs_more_context/review_required. Range: 0.0-1.0.
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.85
# Global model-role mapping. Each value must be fast or deep. Provider profiles
# configure the concrete model and optional endpoint/API key for each role.
CLASSIFICATION_STAGE_0_ROLE=fast
CLASSIFICATION_STAGE_1_ROLE=fast
CLASSIFICATION_STAGE_2_ROLE=deep
CLASSIFICATION_STAGE_3_ROLE=deep
THREAD_SUMMARY_MODEL_ROLE=fast
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ── Attachment extraction ─────────────────────────────────────────────────────
# Attachment bodies are only inspected as bounded classification escalation.
ATTACHMENT_MAX_BYTES=5242880
ATTACHMENT_MAX_EXTRACTED_CHARS=8000
ATTACHMENT_MAX_COUNT=2
ATTACHMENT_MAX_PDF_PAGES=50
ATTACHMENT_MAX_ARCHIVE_ENTRIES=64
ATTACHMENT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=2097152

# ── Workers ───────────────────────────────────────────────────────────────────
WORKER_CYCLE_INTERVAL_SECONDS=300
WORKER_MAX_EMAILS_PER_CYCLE=20
WORKER_PAUSED=false

# ── Observability ─────────────────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO
ENVIRONMENT=development
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
