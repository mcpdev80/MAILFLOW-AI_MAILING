# MailFlow — Environment variables
# Copy to .env and fill in your values. Never commit .env.

# ── Deployment/bootstrap metadata ─────────────────────────────────────────────
# Deployment tools set these so the GUI can show already-configured values
# instead of asking for them again. Supported sources: cli, compose, helm,
# operator, environment. Language is only the initial preference and users may
# override it later.
MAILFLOW_DEPLOYMENT_SOURCE=compose
MAILFLOW_BOOTSTRAP_LANGUAGE=
MAILFLOW_TLS_MODE=

# ── Public HTTPS edge ─────────────────────────────────────────────────────────
# Production: one canonical public URL, e.g. https://mail.example.com
MAILFLOW_PUBLIC_URL=https://localhost
# Caddy listens on its normal internal 80/443 ports even when the host publishes
# alternate ports. Deployment tools normally derive this from the public host.
MAILFLOW_CADDY_ADDRESS=https://localhost
HTTP_PORT=80
HTTPS_PORT=443
# Set by the guided CLI after it has checked/selected host ports. It prevents a
# later rerun from moving an existing installation to different ports merely
# because Mailflow itself is already listening on them.
MAILFLOW_PORTS_MANAGED=
# Optional custom certificate mode (docker-compose.custom-tls.yml).
# Wildcard certificates are supported when they cover MAILFLOW_PUBLIC_URL's host.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Optional enterprise/custom CA bundle (docker-compose.custom-ca.yml).
# Supply a PEM bundle trusted for outbound IMAP/LLM/OAuth/HTTPS connections.
MAILFLOW_CA_BUNDLE=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mailflow:mailflow@localhost:5432/mailflow
POSTGRES_DB=mailflow
POSTGRES_USER=mailflow
POSTGRES_PASSWORD=mailflow

# ── Redis (ARQ queue) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Crypto ────────────────────────────────────────────────────────────────────
SECRET_KEY=
SECRET_ENCRYPTION_KEYS=

# ── CORS / API exposure ───────────────────────────────────────────────────────
# Browser traffic normally uses the same-origin Next.js BFF, so production may
# leave this empty. Never use * with credentialed production requests.
CORS_ORIGINS=http://localhost:3000
API_DOCS_ENABLED=false

# ── API auth mode ─────────────────────────────────────────────────────────────
AUTH_MODE=single
SINGLE_TENANT_API_KEY=

# ── Auth (Better Auth — web layer, SaaS) ──────────────────────────────────────
WEB_AUTH=off
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000
PASSKEY_RP_NAME=MailFlow
PASSKEY_RP_ID=
PASSKEY_ORIGIN=
WEB_SECRET_KEY=change-me-too-in-production
API_INTERNAL_URL=http://localhost:8000

# ── Internal web ↔ API trust secret ───────────────────────────────────────────
INTERNAL_API_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── OAuth — Microsoft 365 ──────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── OAuth — Gmail ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — redirect/callback ─────────────────────────────────────────────────
# Production should use MAILFLOW_PUBLIC_URL here, without a trailing slash.
OAUTH_REDIRECT_BASE=http://localhost:8000
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/app/dashboard

# ── Billing (Stripe) — SaaS only ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
BILLING_SUCCESS_URL=http://localhost:3000/app/billing?status=success
BILLING_CANCEL_URL=http://localhost:3000/app/billing?status=cancel

# ── LLM defaults (LiteLLM) ───────────────────────────────────────────────────
LITELLM_DEFAULT_MODEL=ollama/llama3.1:8b
LITELLM_DEFAULT_BASE_URL=http://localhost:11434
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.85
DECISION_MEMORY_REUSE_THRESHOLD=0.93
DECISION_MEMORY_HINT_THRESHOLD=0.68
DECISION_MEMORY_DECAY_DAYS=180
CLASSIFICATION_STAGE_0_ROLE=fast
CLASSIFICATION_STAGE_1_ROLE=fast
CLASSIFICATION_STAGE_2_ROLE=deep
CLASSIFICATION_STAGE_3_ROLE=deep
THREAD_SUMMARY_MODEL_ROLE=fast
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ── Attachment extraction ─────────────────────────────────────────────────────
ATTACHMENT_MAX_BYTES=5242880
ATTACHMENT_MAX_EXTRACTED_CHARS=8000
ATTACHMENT_MAX_COUNT=2
ATTACHMENT_MAX_PDF_PAGES=50
ATTACHMENT_MAX_ARCHIVE_ENTRIES=64
ATTACHMENT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=2097152

# ── Workers ───────────────────────────────────────────────────────────────────
WORKER_CYCLE_INTERVAL_SECONDS=300
WORKER_MAX_EMAILS_PER_CYCLE=20
WORKER_PAUSED=false

# ── Observability ─────────────────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO
ENVIRONMENT=development
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Billing / retention defaults ──────────────────────────────────────────────
BILLING_PROVIDER=none
DATA_RETENTION_DAYS=30
