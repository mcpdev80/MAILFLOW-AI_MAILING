# MailFlow — Environment variables
# Copy to .env and fill in your values. Never commit .env.

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL only (the code uses PG-specific features: ARRAY, ON CONFLICT, UUID).
DATABASE_URL=postgresql+asyncpg://mailflow:mailflow@localhost:5432/mailflow

# ── Redis (ARQ queue) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Crypto ────────────────────────────────────────────────────────────────────
# REQUIRED. Existing deployment signing secret. While SECRET_ENCRYPTION_KEYS is
# empty, this is also used as the legacy Fernet key for encrypted DB credentials.
# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Treat it as a top secret and keep it outside PostgreSQL and database backups.
SECRET_KEY=
# Optional independent Fernet key ring for database secrets. First key = primary
# for new writes, later keys = decrypt-only fallbacks during rotation. Once this
# variable is set it fully owns DB encryption; SECRET_KEY is no longer added.
# Example migration/rotation from the legacy key:
#   SECRET_ENCRYPTION_KEYS=NEW_FERNET_KEY,OLD_SECRET_KEY
#   python -m app.secret_rotation
#   SECRET_ENCRYPTION_KEYS=NEW_FERNET_KEY
SECRET_ENCRYPTION_KEYS=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API. Defaults to the local
# frontend. In production set this to your real app domain(s).
CORS_ORIGINS=http://localhost:3000

# ── API auth mode ─────────────────────────────────────────────────────────────
# "single" — self-host: one default organization, no token required.
# "multi"  — SaaS: every request must send an API key (X-API-Key or
#            Authorization: Bearer <key>) that resolves to an organization.
AUTH_MODE=single
# Optional API key for "single" mode. If set, requests must send it; if empty,
# the self-host API is open (intended for local/LAN use only).
SINGLE_TENANT_API_KEY=

# ── Auth (Better Auth — web layer, SaaS) ──────────────────────────────────────
# WEB_AUTH=on enables login/signup + org provisioning in the web app (SaaS).
# WEB_AUTH=off (default) = self-host single-tenant: no login, current flow.
WEB_AUTH=off
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000
# Passkey/WebAuthn settings. Defaults are derived from BETTER_AUTH_URL. In
# production use HTTPS and keep the public hostname/RP-ID stable: changing it can
# make previously registered passkeys unusable. RP-ID is a hostname, not a URL.
PASSKEY_RP_NAME=MailFlow
PASSKEY_RP_ID=
PASSKEY_ORIGIN=
# Key used by the web layer to encrypt the org API key at rest (AES-256-GCM)
# inside the Better Auth organization metadata. Any string; derived via SHA-256.
WEB_SECRET_KEY=change-me-too-in-production
# Internal base URL the web server uses to reach the FastAPI (server-to-server,
# internal network only — used for POST /internal/orgs and the BFF proxy).
API_INTERNAL_URL=http://localhost:8000

# ── Internal web ↔ API trust secret ───────────────────────────────────────────
# Shared server-side secret used for two trusted internal operations:
#   1. X-Internal-Secret on POST /internal/orgs during org provisioning.
#   2. HMAC signing of the Better Auth user identity forwarded by the BFF.
# In multi-user mode this must be configured identically in web and API.
# Never expose it to the browser or public clients. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── OAuth — Microsoft 365 ─────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── OAuth — Gmail ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — redirect/callback ─────────────────────────────────────────────────
# Public base URL of the API where providers redirect after consent. The full
# callback is {OAUTH_REDIRECT_BASE}/oauth/{provider}/callback — register that
# exact URL in the Google Cloud / Azure app. Examples:
#   Gmail:     {OAUTH_REDIRECT_BASE}/oauth/gmail/callback
#   Microsoft: {OAUTH_REDIRECT_BASE}/oauth/microsoft/callback
OAUTH_REDIRECT_BASE=http://localhost:8000
# Where to send the user in the web app after connecting (success or ?error=).
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/app/dashboard

# ── Billing (Stripe) — SaaS only ──────────────────────────────────────────────
# Empty = billing disabled (endpoints return 501; self-host has no plan limits).
# Plan limits are only enforced when AUTH_MODE=multi (managed SaaS).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for the recurring subscriptions.
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
BILLING_SUCCESS_URL=http://localhost:3000/app/billing?status=success
BILLING_CANCEL_URL=http://localhost:3000/app/billing?status=cancel

# ── LLM defaults (LiteLLM) ───────────────────────────────────────────────────
# Users can override per workspace. These are server-side defaults.
LITELLM_DEFAULT_MODEL=ollama/llama3.1:8b
LITELLM_DEFAULT_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ── Workers ───────────────────────────────────────────────────────────────────
WORKER_CYCLE_INTERVAL_SECONDS=300
WORKER_MAX_EMAILS_PER_CYCLE=20

# ── Observability ─────────────────────────────────────────────────────────────
# Structured logs (one JSON line per event) for api + worker. Use "text" locally.
LOG_FORMAT=json
LOG_LEVEL=INFO
ENVIRONMENT=development
# Sentry error reporting. Empty = disabled (no events, no network). Set the DSN
# from your Sentry project to enable. Traces sampling is off by default.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
