FROM python:3.13-slim

WORKDIR /app

# Create the unprivileged runtime user before copying application files. This
# lets COPY assign ownership directly instead of recursively chowning the whole
# uv environment at the end of every build.
RUN pip install uv \
    && useradd --create-home --uid 10001 appuser \
    && chown appuser:appuser /app

# Dependencies (cacheable layer): copy manifests with final ownership first.
COPY --chown=appuser:appuser pyproject.toml ./
COPY --chown=appuser:appuser apps/api/pyproject.toml apps/api/
COPY --chown=appuser:appuser apps/worker/pyproject.toml apps/worker/
COPY --chown=appuser:appuser packages/core/pyproject.toml packages/core/

RUN uv sync --no-dev

# Worker code and shared dependencies already receive their final ownership.
COPY --chown=appuser:appuser apps/api/app/ apps/api/app/
COPY --chown=appuser:appuser apps/worker/worker/ apps/worker/worker/
COPY --chown=appuser:appuser packages/core/mailflow_core/ packages/core/mailflow_core/

# The worker imports `worker.*`, `app.*` and the shared `mailflow_core` package.
ENV PYTHONPATH=/app/apps/worker:/app/apps/api:/app/packages/core

USER appuser

CMD ["uv", "run", "arq", "worker.main.WorkerSettings"]
