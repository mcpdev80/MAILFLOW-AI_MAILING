FROM python:3.13-slim

WORKDIR /app

RUN pip install uv \
    && useradd --create-home --uid 10001 appuser \
    && chown appuser:appuser /app

# Dependency manifests first so dependency installation remains cacheable.
COPY --chown=appuser:appuser pyproject.toml ./
COPY --chown=appuser:appuser apps/api/pyproject.toml apps/api/
COPY --chown=appuser:appuser packages/core/pyproject.toml packages/core/

USER appuser
RUN uv sync --no-dev

# Application code, migrations and entrypoint are copied with final ownership.
COPY --chown=appuser:appuser apps/api/app/ apps/api/app/
COPY --chown=appuser:appuser apps/api/alembic/ apps/api/alembic/
COPY --chown=appuser:appuser apps/api/alembic.ini apps/api/alembic.ini
COPY --chown=appuser:appuser packages/core/mailflow_core/ packages/core/mailflow_core/
COPY --chown=appuser:appuser infrastructure/docker/entrypoint.api.sh /entrypoint.api.sh

USER root
RUN chmod +x /entrypoint.api.sh && chown appuser:appuser /entrypoint.api.sh
USER appuser

EXPOSE 8000

# The entrypoint applies migrations and starts uvicorn.
ENTRYPOINT ["/entrypoint.api.sh"]
